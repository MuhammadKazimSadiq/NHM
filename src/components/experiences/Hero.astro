---
import { Image } from "astro:assets";
import heroImg from "/src/images/experiences/hero.jpg";
---

<section class="relative flex hero-viewport items-center justify-center overflow-hidden text-white">
  <!-- Parallax wrapper -->
  <div id="experiences-hero-parallax" class="absolute inset-0 will-change-transform">

    <!-- Mobile image -->
    <div class="block md:hidden absolute inset-0">
      <Image
        src={heroImg}
        alt="Featured experiences in Iran"
        priority
        sizes="100vw"
        class="h-[120%] w-full object-cover"
      />
    </div>

    <!-- Desktop video -->
    <div class="hidden md:block absolute inset-0">
      <video
        src="/videos/featured-experiences.mp4"
        class="h-[120%] w-full object-cover"
        autoplay
        muted
        loop
        playsinline
        preload="none"
        poster={heroImg.src}
      ></video>
    </div>

  </div>

  <!-- Gradient overlay adapted for top nav and centered heading -->
  <div
    class="pointer-events-none absolute inset-0 z-[5] experiences-hero-overlay"
    aria-hidden="true"
  ></div>

  <!-- Content -->
  <div class="relative z-10 container mx-auto flex w-full items-center justify-center px-4 text-center">
    <div class="fade-in slow">
      <!-- Eyebrow -->
      <div class="mb-2 text-xl font-light uppercase tracking-[0.18em] opacity-90 max-sm:text-xs max-sm:tracking-[0.12em]">
        EXPLORE
      </div>

      <!-- Title -->
      <h1 class="font-heading mb-8 font-bold leading-[1.4] text-[clamp(20px,7vw,100px)] drop-shadow-[0_4px_25px_rgba(0,0,0,0.45)]">
        <span class="block">Featured</span>
        <span class="block">Experiences</span>
      </h1>
    </div>
  </div>
</section>

<style>
.hero-viewport {
  height: 94vh;
  height: 94dvh;
  min-height: 520px;
}

@media (max-width: 640px) {
  .hero-viewport {
    height: 93vh;
    height: 93dvh;
    min-height: 480px;
  }
}

.experiences-hero-overlay {
  background:
    radial-gradient(ellipse 65% 45% at 50% 50%, rgba(0, 0, 0, 0.28) 0%, transparent 70%),
    linear-gradient(
      to bottom,
      rgba(0, 0, 0, 0.48) 0%,
      rgba(0, 0, 0, 0.12) 18%,
      transparent 35%,
      transparent 75%,
      rgba(0, 0, 0, 0.35) 100%
    );
}
</style>

<script>
(() => {
  const parallax = document.getElementById("experiences-hero-parallax");
  if (!parallax) return;

  // Respect reduced motion
  if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;

  let latestScroll = 0;
  let ticking = false;

  const isMobile = window.matchMedia("(max-width: 768px)").matches;
  const strength = isMobile ? 0.15 : 0.5; // lighter on mobile
  const fadeDistance = isMobile ? 800 : 500;

  function update() {
    const translateY = latestScroll * strength;
    parallax.style.transform = `translateY(${translateY}px)`;

    if (!isMobile) {
      const opacity = Math.max(0.6, 1 - latestScroll / fadeDistance);
      parallax.style.opacity = opacity.toString();
    }

    ticking = false;
  }

  window.addEventListener("scroll", () => {
    latestScroll = window.scrollY;
    if (!ticking) {
      requestAnimationFrame(update);
      ticking = true;
    }
  });
})();
</script>
