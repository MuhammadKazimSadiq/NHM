---
import { Image } from "astro:assets";
const { img, alt, title, subtitle, items } = Astro.props;
---


<div
  class="group flex h-full max-w-sm flex-col overflow-hidden rounded-2xl bg-[#fff8ec] shadow-[0_8px_24px_rgba(0,0,0,0.25)] transition-all duration-300 hover:-translate-y-2 hover:shadow-[0_18px_36px_rgba(0,0,0,0.35)]"
  style="animation-delay: calc(sibling-index() * 100ms);"
>

  <!-- Image section -->
  <div class="relative h-60 shrink-0 overflow-hidden">
    <Image
      src={img}
      alt={alt}
      class="block h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
    />

    <!-- Image overlay -->
    <div
      class="absolute inset-0 bg-gradient-to-t from-black/75 via-black/10 to-transparent"
      aria-hidden="true"
    ></div>

    
    <!-- Image text -->
    <div class="absolute bottom-5 left-5 right-4 text-white">
      <h3 class="text-xl font-bold drop-shadow-md">{title}</h3>
      <p class="mt-1 text-sm text-white/85">{subtitle}</p>
    </div>
  </div>

  <!-- Content section -->
  <div class="flex flex-1 flex-col justify-between bg-[#fff8ec] p-6">
    <ul class="mb-7 space-y-3 text-gray-800">
      {items.map((item: string) => (
        <li class="flex items-start gap-3 text-sm leading-relaxed">
          <span
            class="mt-0.5 flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-[#c6a36a]/15 text-xs font-bold text-[#8b642f]"
            aria-hidden="true"
          >
            ✓
          </span>
          <span>{item}</span>
        </li>
      ))}
    </ul>


<!-- Learn more button -->
<div class="mt-auto w-full border-t border-[#c6a36a]/30 pt-5">
  <a
    href="/services"
    class="flex w-full items-center justify-center gap-2 rounded-full border border-[#d99a45] bg-[#d99a45] px-5 py-3.5 text-sm font-semibold tracking-wide text-[#3b2918] shadow-[0_4px_12px_rgba(0,0,0,0.12)] transition-all duration-300 hover:-translate-y-0.5 hover:border-[#e8b65e] hover:bg-[#e8b65e] hover:shadow-[0_6px_16px_rgba(0,0,0,0.2)] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#d99a45]"
  >
    LEARN MORE
    <span class="transition-transform duration-300 group-hover:translate-x-1" aria-hidden="true">→</span>
  </a>
</div>



  </div>
</div>


