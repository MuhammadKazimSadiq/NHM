---
import ServiceCard from "./ServiceCard.astro"
import Service_1 from "../../images/index/service-1.jpg"
import Service_2 from "../../images/index/service-2.jpg"
import Service_3 from "../../images/index/service-3.jpg"
import servicesBackground from "../../images/index/servicesbackground.webp";

const services = [
  {
    img: Service_1,
    alt: "General Services",
    title: "General Services",
    subtitle: "Smooth, Custom services",
    items: [
      "Meet and greet",
      "Multilingual Staff",
      "Hotel Bookings",
      "Tourism",
      "Transportation"
    ]
  },
  {
    img: Service_2,
    alt: "Specialized Package",
    title: "Specialized Package",
    subtitle: "Tailored to your purposes",
    items: [
      "Nikah ceremonies",
      "Honeymoon",
      "Medical Tourism",
      "Company Registration",
      "Property Services"
    ]
  },
  {
    img: Service_3,
    alt: "Customized Package",
    title: "Customized Package",
    subtitle: "Smooth and comfortable",
    items: [
      "Airport transfers and transportation",
      "Ticketing and Visa services",
      "Atraf Ziyarah",
      "Transportation"
    ]
  }
];
---

<section
  id="services"
  class="relative isolate overflow-hidden bg-[#5a422f] py-20"
>
  <!-- Blurred background image -->
  <div
    class="absolute inset-0 scale-105 blur-md"
    style={`background-image: url('${servicesBackground.src}'); background-size: cover; background-position: center;`}
    aria-hidden="true"
  ></div>

  <!-- Brown overlay -->
  <div
    class="absolute inset-0 bg-[#5a422f]/85"
    aria-hidden="true"
  ></div>

  <div class="container relative z-10">
    <!-- Header -->
    <header class="mb-12 text-center">
      <h2 class="font-heading font-bold text-white text-section-heading drop-shadow-[0_4px_10px_rgba(0,0,0,0.6)]">
        Our Services
      </h2>
    </header>

    <!-- Grid -->
    <div class="grid gap-12 sm:grid-cols-2 lg:grid-cols-3 justify-center">
      {services.map((service) => (
        <ServiceCard {...service} />
      ))}
    </div>
  </div>
</section>