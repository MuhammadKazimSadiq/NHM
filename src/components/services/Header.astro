---
import { Image } from "astro:assets";
import heroImg from "/src/images/services/hero.jpg";
---

<section class="services-hero relative hero-viewport overflow-hidden text-white">
  <!-- Parallax image -->
  <div
    id="services-parallax"
    class="absolute inset-0 will-change-transform"
  >
    <Image
      src={heroImg}
      alt="NHM Travels services hero"
      priority
      sizes="100vw"
      class="hero-image h-[120%] w-full object-cover object-center"
    />
  </div>

  <!-- Gradient overlay adapted for top nav and bottom content -->
  <div
    class="pointer-events-none absolute inset-0 z-[5] services-hero-overlay"
    aria-hidden="true"
  ></div>

  <!-- Content -->
  <div class="relative z-10 flex h-full flex-col justify-end p-5 sm:p-8 lg:p-12 gap-y-6 sm:gap-y-8 pb-6 sm:pb-8 lg:pb-12">
    <h1 class="font-heading font-bold leading-[1.3] sm:leading-[1.4] text-heading-xl drop-shadow-[0_20px_48px_rgba(0,0,0,1)] lg:ml-16 w-full lg:w-2/3 fade-in slow">
      Answer the call, leave everything behind.
    </h1>

    <div class="flex justify-start lg:justify-end">
      <a
        href="https://api.whatsapp.com/send/?phone=989398597862&text=Hello+NHM+Travels%2C+I%27m+interested+in+booking+a+trip.+Please+help+me+with+itinerary+and+pricing.&type=phone_number&app_absent=0"
        class="
          mr-0 sm:mr-8 lg:mr-12 mb-2 sm:mb-4 lg:mb-6 inline-block rounded-full
          bg-[#0dbdad] px-8 sm:px-12 py-3.5 sm:py-4
          font-light text-white text-base sm:text-lg
          transition
          hover:-translate-y-0.5
          hover:brightness-90
          fly-left
        "
      >
        BOOK NOW →
      </a>
    </div>
  </div>
</section>

<style>
.hero-viewport {
  height: 94vh;
  height: 94dvh;
  min-height: 520px;
}

@media (max-width: 640px) {
  .hero-viewport {
    height: 93vh;
    height: 93dvh;
    min-height: 480px;
  }
}

.services-hero-overlay {
  background:
    radial-gradient(ellipse 80% 60% at 20% 100%, rgba(0, 0, 0, 0.55) 0%, transparent 75%),
    linear-gradient(
      to bottom,
      rgba(0, 0, 0, 0.48) 0%,
      rgba(0, 0, 0, 0.12) 18%,
      transparent 35%,
      rgba(0, 0, 0, 0.25) 65%,
      rgba(0, 0, 0, 0.6) 100%
    );
}

.hero-image {
  transition: opacity 0.25s linear;
}
</style>

<script>
(() => {
  const parallax = document.getElementById(
    "services-parallax"
  ) as HTMLDivElement | null;

  if (!parallax) return;

  // Disable on mobile
  if (window.matchMedia("(max-width: 768px)").matches) return;

  // Respect reduced motion
  if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;

  let latestScroll = 0;
  let ticking = false;

  const strength = 0.5;      // 🔥 strong parallax
  const fadeDistance = 500;  // fade range

  function update() {
    if (!parallax) return;
    const translateY = latestScroll * strength;

    // Fade from 1 → 0.6
    const opacity = Math.max(
      0.6,
      1 - latestScroll / fadeDistance
    );

    parallax.style.transform = `translateY(${translateY}px)`;
    parallax.style.opacity = opacity.toString();

    ticking = false;
  }

  window.addEventListener("scroll", () => {
    latestScroll = window.scrollY;

    if (!ticking) {
      requestAnimationFrame(update);
      ticking = true;
    }
  });
})();
</script>
