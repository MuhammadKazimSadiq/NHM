---
import Layout from '../layouts/Layout.astro';

import Hero from '../components/explore/Hero.astro';
import CityList from '../components/explore/CityList.astro';
import Contact from '../components/explore/Contact.astro';
---

<Layout title="Explore | NHM Travels">
    <Hero />
    <CityList />
    <Contact />



<script>
  function initHeroVideo() {
    const video = document.getElementById("heroVideo") as HTMLVideoElement | null;
    const playBtn = document.getElementById("playBtn") as HTMLElement | null;

    if (!video) return;

    // Force the browser to load the source after Astro swaps pages.
    video.load();

    if (playBtn) {
      playBtn.style.display = "block";
    }

    video.addEventListener("playing", () => {
      if (playBtn) playBtn.style.display = "none";
    }, { once: true });

    video.play().catch((error) => {
      console.log("Video autoplay failed:", error);
    });
  }

  document.addEventListener("astro:page-load", initHeroVideo);
</script>
</Layout>
